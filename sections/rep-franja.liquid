{%- liquid
  assign s = section.settings
  if s.image != blank
    assign franja_src = s.image | image_url: width: 2000
  else
    assign franja_src = 'rep-monta-1.jpg' | asset_url
  endif
-%}

<section class="rep rep-franja" style="background-image: url('{{ franja_src }}');">
  <div class="rep-franja__in">
    <div class="rep-franja__wrap">
      <p class="rep-franja__h">
        {{- s.heading_1 | escape }}
        {% if s.heading_2 != blank %}<span class="rep-red">{{ s.heading_2 | escape }}</span>{% endif -%}
      </p>
      {%- if s.text != blank -%}
        <p class="rep-franja__p">{{ s.text | escape }}</p>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "REP · Frase con foto",
  "tag": "div",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Foto de fondo" },
    { "type": "text", "id": "heading_1", "label": "Frase", "default": "Poquito" },
    { "type": "text", "id": "heading_2", "label": "Frase (en rojo)", "default": "pero fino." },
    {
      "type": "textarea",
      "id": "text",
      "label": "Texto",
      "default": "Cada gorra lleva el fierro de Rancho El Principio, Selección Colimense de Chuy Ordaz."
    }
  ],
  "presets": [{ "name": "REP · Frase con foto" }]
}
{% endschema %}
