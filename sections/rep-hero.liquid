{%- liquid
  assign s = section.settings
  if s.image != blank
    assign hero_src = s.image | image_url: width: 1400
    assign hero_alt = s.image.alt | default: s.image_alt
  else
    assign hero_src = 'rep-monta-1.jpg' | asset_url
    assign hero_alt = s.image_alt
  endif
-%}

<section class="rep rep-hero{% if s.show_camo %} rep-camo{% else %} rep-hero--plain{% endif %}{% if s.photo_bg_mobile %} rep-hero--photo{% endif %}">
  {%- if s.photo_bg_mobile -%}
    {%- comment -%} En teléfono, los toros quedan de fondo desde la primera vista. {%- endcomment -%}
    <img
      class="rep-hero__bg"
      src="{{ hero_src }}"
      alt=""
      aria-hidden="true"
      width="1600"
      height="1066"
      style="object-position: {{ s.mobile_image_position | default: '34% 50%' }};"
      fetchpriority="high"
    >
  {%- endif -%}
  <div class="rep-hero__veil">
    <div class="rep-hero__grid">
      <div class="rep-hero__col">
        {%- if s.kicker != blank -%}
          <p class="rep-kicker">{{ s.kicker | escape }}</p>
        {%- endif -%}

        <h1 class="rep-hero__title">
          <span>{{ s.title_1 | escape }}</span>
          <span>{{ s.title_2 | escape }}</span>
          <span class="rep-red">{{ s.title_3 | escape }}</span>
        </h1>

        {%- if s.text != blank -%}
          <p class="rep-hero__text">{{ s.text | escape }}</p>
        {%- endif -%}

        <div class="rep-stack">
          {%- if s.button_1_label != blank -%}
            <a class="rep-btn rep-btn--white" href="{{ s.button_1_link | default: routes.all_products_collection_url }}">
              {{- s.button_1_label | escape -}}
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
            </a>
          {%- endif -%}
          {%- if s.button_2_label != blank -%}
            <a class="rep-btn rep-btn--line" href="{{ s.button_2_link | default: '#ganaderia' }}">
              {{- s.button_2_label | escape -}}
            </a>
          {%- endif -%}
        </div>

        <ul class="rep-trust">
          {%- for i in (1..3) -%}
            {%- assign key = 'trust_' | append: i -%}
            {%- if s[key] != blank -%}
              <li><span class="rep-dia" aria-hidden="true"></span>{{ s[key] | escape }}</li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      </div>

      <div class="rep-hero__media">
        <img
          src="{{ hero_src }}"
          alt="{{ hero_alt | escape }}"
          width="1600"
          height="1066"
          style="object-position: {{ s.image_position | default: '50% 50%' }};"
          fetchpriority="high"
        >
        {%- if s.stamp_large != blank -%}
          <div class="rep-stamp" aria-hidden="true">
            <span class="rep-stamp__s">{{ s.stamp_small | escape }}</span>
            <span class="rep-stamp__l">{{ s.stamp_large | escape }}</span>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "REP · Portada",
  "tag": "div",
  "settings": [
    { "type": "checkbox", "id": "show_camo", "label": "Fondo de camuflaje", "default": true },
    {
      "type": "checkbox",
      "id": "photo_bg_mobile",
      "label": "Foto de los toros de fondo en teléfono",
      "info": "En pantallas chicas la foto queda detrás de la frase para que se vea desde la primera vista.",
      "default": true
    },
    { "type": "text", "id": "mobile_image_position", "label": "Encuadre de la foto en teléfono (x% y%)", "default": "34% 50%" },
    { "type": "text", "id": "kicker", "label": "Antetítulo", "default": "Selección Colimense · Chuy Ordaz" },
    { "type": "text", "id": "title_1", "label": "Frase · línea 1", "default": "¡¡Hay" },
    { "type": "text", "id": "title_2", "label": "Frase · línea 2", "default": "niveles" },
    { "type": "text", "id": "title_3", "label": "Frase · línea 3 (en rojo)", "default": "pareja!!" },
    {
      "type": "textarea",
      "id": "text",
      "label": "Texto",
      "default": "Mercancía oficial de Rancho El Principio, la ganadería de Chuy Ordaz. Para la gente que vive el jaripeo, desde la barrera hasta el ruedo."
    },
    { "type": "text", "id": "button_1_label", "label": "Botón principal", "default": "Comprar colección" },
    { "type": "url", "id": "button_1_link", "label": "Enlace del botón principal", "default": "/collections/all" },
    { "type": "text", "id": "button_2_label", "label": "Botón secundario", "default": "Conoce la ganadería" },
    { "type": "text", "id": "button_2_link", "label": "Enlace del botón secundario", "default": "#ganaderia" },
    { "type": "text", "id": "trust_1", "label": "Confianza 1", "default": "Envíos a todo México" },
    { "type": "text", "id": "trust_2", "label": "Confianza 2", "default": "Pago seguro" },
    { "type": "text", "id": "trust_3", "label": "Confianza 3", "default": "Producto oficial" },
    { "type": "image_picker", "id": "image", "label": "Foto" },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Descripción de la foto",
      "default": "Jinete montando un toro frente a la manta #HayNivelesPareja"
    },
    { "type": "text", "id": "image_position", "label": "Encuadre de la foto (x% y%)", "default": "34% 50%" },
    { "type": "text", "id": "stamp_small", "label": "Sello · línea chica", "default": "Poquito" },
    { "type": "text", "id": "stamp_large", "label": "Sello · línea grande", "default": "pero fino" }
  ],
  "presets": [{ "name": "REP · Portada" }]
}
{% endschema %}
