{%- liquid
  assign s = section.settings
  assign mensajes = section.blocks | where: 'type', 'mensaje'
-%}

{%- if mensajes.size > 0 -%}
  <div class="rep3 rep3-aviso" id="rep3-aviso-{{ section.id }}" data-ms="{{ s.seconds | times: 1000 }}">
    <div class="rep3-aviso__pista" aria-live="polite">
      {%- for block in mensajes -%}
        {%- liquid
          assign b = block.settings
          assign etiqueta = 'p'
          if b.link != blank
            assign etiqueta = 'a'
          endif
        -%}
        <{{ etiqueta }}
          class="rep3-aviso__in{% if forloop.first %} is-activo{% endif %}"
          {% if b.link != blank %}href="{{ b.link }}"{% endif %}
          {% unless forloop.first %}aria-hidden="true"{% endunless %}
          {{ block.shopify_attributes }}
        >
          {%- if b.icono == 'camion' -%}
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 6h11v10H2z"/><path d="M13 9h5l3 3v4h-8z"/><circle cx="6" cy="17.5" r="1.8"/><circle cx="17" cy="17.5" r="1.8"/></svg>
          {%- elsif b.icono == 'gorra' -%}
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 15a8 8 0 0 1 16 0z"/><path d="M12 7V5"/><path d="M20 15c0 1.5-1.5 2.5-4 2.5H3"/></svg>
          {%- endif -%}
          <span>{{ b.text | escape }}</span>
        </{{ etiqueta }}>
      {%- endfor -%}
    </div>
  </div>

  {%- if mensajes.size > 1 -%}
    <script>
      (function () {
        var raiz = document.getElementById('rep3-aviso-{{ section.id }}');
        if (!raiz) return;
        if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        var items = raiz.querySelectorAll('.rep3-aviso__in');
        var i = 0;
        var ms = parseInt(raiz.dataset.ms, 10) || 4000;
        var reloj = setInterval(function () {
          // Al cambiar de página sin recargar este aviso se reemplaza: detener su temporizador
          if (!raiz.isConnected) return clearInterval(reloj);
          items[i].classList.remove('is-activo');
          items[i].setAttribute('aria-hidden', 'true');
          i = (i + 1) % items.length;
          items[i].classList.add('is-activo');
          items[i].removeAttribute('aria-hidden');
        }, ms);
      })();
    </script>
  {%- endif -%}
{%- endif -%}

{% schema %}
{
  "name": "REP3 · Aviso",
  "tag": "div",
  "settings": [
    {
      "type": "range",
      "id": "seconds",
      "label": "Segundos por mensaje",
      "min": 2,
      "max": 10,
      "step": 1,
      "unit": "s",
      "default": 4
    }
  ],
  "blocks": [
    {
      "type": "mensaje",
      "name": "Mensaje",
      "settings": [
        { "type": "text", "id": "text", "label": "Texto", "default": "Envíos a todo México y Estados Unidos" },
        {
          "type": "select",
          "id": "icono",
          "label": "Ícono",
          "options": [
            { "value": "camion", "label": "Camión" },
            { "value": "gorra", "label": "Gorra" },
            { "value": "ninguno", "label": "Ninguno" }
          ],
          "default": "camion"
        },
        { "type": "url", "id": "link", "label": "Enlace (opcional)" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "REP3 · Aviso",
      "blocks": [
        { "type": "mensaje", "settings": { "text": "Envíos a todo México y Estados Unidos", "icono": "camion" } },
        { "type": "mensaje", "settings": { "text": "Envío gratis en la compra de 3 gorras o más", "icono": "gorra" } }
      ]
    }
  ]
}
{% endschema %}
