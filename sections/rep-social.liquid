{%- liquid
  assign s = section.settings
  assign fallback_images = 'rep-monta-2.jpg|rep-chuy.jpg|rep-monta-3.jpg|rep-monta-1.jpg|rep-monta-2.jpg|rep-monta-3.jpg' | split: '|'
  assign embed_blocks = section.blocks | where: 'type', 'embed'
  assign image_blocks = section.blocks | where: 'type', 'post'
-%}

<section class="rep rep-light">
  <div class="rep-wrap">
    <div class="rep-sec-head">
      <div class="rep-sec-head__titles">
        {%- if s.label != blank -%}
          <p class="rep-label">{{ s.label | escape }}</p>
        {%- endif -%}
        <h2 class="rep-h2">{{ s.heading | escape }}</h2>
      </div>

      <div class="rep-stack" style="width: 100%; max-width: 720px;">
        {%- if s.instagram_url != blank -%}
          <a class="rep-btn rep-btn--dark rep-btn--social" href="{{ s.instagram_url }}" target="_blank" rel="noopener">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor"/></svg>
            {{- s.instagram_label | escape -}}
          </a>
        {%- endif -%}
        {%- if s.youtube_url != blank -%}
          <a class="rep-btn rep-btn--dark rep-btn--social" href="{{ s.youtube_url }}" target="_blank" rel="noopener">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="5" width="20" height="14" rx="4"/><path d="M10 9l5 3-5 3z" fill="currentColor"/></svg>
            YouTube
          </a>
        {%- endif -%}
        {%- if s.facebook_url != blank -%}
          <a class="rep-btn rep-btn--dark rep-btn--social" href="{{ s.facebook_url }}" target="_blank" rel="noopener">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 3h-2.5A3.5 3.5 0 0 0 9 6.5V10H6v4h3v7h4v-7h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
            Facebook
          </a>
        {%- endif -%}
      </div>
    </div>

    {%- if embed_blocks.size > 0 -%}
      {%- comment -%}
        Publicaciones reales de Instagram (embed oficial) en tarjetas del mismo tamaño:
        barra del perfil + foto cuadrada, deslizables en teléfono.
      {%- endcomment -%}
      <div class="rep-embeds">
        {%- for block in embed_blocks -%}
          {%- liquid
            assign permalink = block.settings.url | split: '?' | first
            assign last_char = permalink | slice: -1
            if last_char != '/'
              assign permalink = permalink | append: '/'
            endif
          -%}
          <div class="rep-embed" {{ block.shopify_attributes }}>
            <iframe
              class="rep-embed__frame"
              src="{{ permalink }}embed/"
              title="Publicación de Instagram de Rancho El Principio"
              loading="lazy"
              scrolling="no"
              allowtransparency="true"
            ></iframe>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if image_blocks.size > 0 -%}
    <div class="rep-ig-grid">
      {%- for block in image_blocks -%}
        {%- liquid
          assign b = block.settings
          if b.image != blank
            assign post_src = b.image | image_url: width: 500
          else
            assign idx = forloop.index0 | modulo: 6
            assign post_src = fallback_images[idx] | asset_url
          endif
          assign post_link = b.link | default: s.instagram_url
        -%}
        <a class="rep-ig" href="{{ post_link }}" target="_blank" rel="noopener" {{ block.shopify_attributes }}>
          <img
            src="{{ post_src }}"
            alt="{{ b.alt | escape }}"
            width="500"
            height="500"
            loading="lazy"
            style="object-position: {{ b.image_position | default: '50% 50%' }};"
          >
          <span class="rep-ig__badge" aria-hidden="true">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/></svg>
          </span>
        </a>
      {%- endfor -%}
    </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "REP · Redes sociales",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "label", "label": "Etiqueta", "default": "#HayNivelesPareja" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Síguenos en el ruedo" },
    { "type": "text", "id": "instagram_url", "label": "Instagram", "default": "https://www.instagram.com/ranchoelprincipio_oficial/" },
    { "type": "text", "id": "instagram_label", "label": "Texto del botón de Instagram", "default": "@ranchoelprincipio_oficial" },
    { "type": "text", "id": "youtube_url", "label": "YouTube", "default": "https://www.youtube.com/c/RanchoElPrincipioOficial" },
    { "type": "text", "id": "facebook_url", "label": "Facebook", "default": "https://www.facebook.com/DeChuyOrdaz/" }
  ],
  "blocks": [
    {
      "type": "embed",
      "name": "Publicación de Instagram",
      "settings": [
        { "type": "text", "id": "url", "label": "Enlace de la publicación", "info": "Ejemplo: https://www.instagram.com/p/XXXXXXXX/" }
      ]
    },
    {
      "type": "post",
      "name": "Publicación",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Foto" },
        { "type": "text", "id": "alt", "label": "Descripción de la foto", "default": "Publicación de Rancho El Principio" },
        { "type": "text", "id": "image_position", "label": "Encuadre (x% y%)", "default": "50% 50%" },
        { "type": "text", "id": "link", "label": "Enlace a la publicación (opcional)" }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "REP · Redes sociales",
      "blocks": [
        { "type": "post", "settings": { "alt": "Jinete volando del toro frente a la manta Hay Niveles Pareja", "image_position": "44% 45%" } },
        { "type": "post", "settings": { "alt": "Chuy Ordaz con sombrero blanco", "image_position": "50% 18%" } },
        { "type": "post", "settings": { "alt": "El toro brinca sobre el jinete caído", "image_position": "58% 55%" } },
        { "type": "post", "settings": { "alt": "Jinete montando un toro frente a la manta #HayNivelesPareja", "image_position": "28% 50%" } },
        { "type": "post", "settings": { "alt": "Manta Hay Niveles Pareja, 100% Colima, en la plaza", "image_position": "94% 62%" } },
        { "type": "post", "settings": { "alt": "El lazador con la reata en el ruedo", "image_position": "4% 40%" } }
      ]
    }
  ]
}
{% endschema %}
