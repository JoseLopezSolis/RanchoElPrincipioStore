{%- liquid
  assign s = section.settings
  if s.image != blank
    assign alt = s.image.alt | default: s.image_alt
  else
    assign alt = s.image_alt
  endif
-%}

<section class="rep rep2-hero">
  {%- if s.image != blank -%}
    <img
      class="rep2-hero__img"
      src="{{ s.image | image_url: width: 1600 }}"
      srcset="{{ s.image | image_url: width: 750 }} 750w, {{ s.image | image_url: width: 1200 }} 1200w, {{ s.image | image_url: width: 1600 }} 1600w, {{ s.image | image_url: width: 2400 }} 2400w"
      sizes="100vw"
      width="{{ s.image.width }}"
      height="{{ s.image.height }}"
      alt="{{ alt | escape }}"
      loading="eager"
      fetchpriority="high"
      style="--rep2-pos-m: {{ s.position_mobile }}; --rep2-pos-d: {{ s.position_desktop }};"
    >
  {%- else -%}
    <img
      class="rep2-hero__img"
      src="{{ 'rep-monta-1.jpg' | asset_url }}"
      width="1600"
      height="1066"
      alt="{{ alt | escape }}"
      loading="eager"
      fetchpriority="high"
      style="--rep2-pos-m: {{ s.position_mobile }}; --rep2-pos-d: {{ s.position_desktop }};"
    >
  {%- endif -%}

  <div class="rep2-hero__txt">
    <div class="rep2-hero__in">
      <h1 class="rep2-hero__h1">
        <span>{{ s.title_1 | escape }}</span>
        <span class="rep2-hero__red">{{ s.title_2 | escape }}</span>
      </h1>
      <div class="rep2-hero__row">
        {%- if s.button_label != blank -%}
          <a class="rep2-btn rep2-btn--crema" href="{{ s.button_link | default: '#gorras' }}">
            {{- s.button_label | escape -}}
          </a>
        {%- endif -%}
        {%- if s.credit != blank -%}
          <span class="rep2-hero__credit">{{ s.credit | escape }}</span>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "REP2 · Portada",
  "tag": "div",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Foto" },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Descripción de la foto",
      "default": "Jinete montando un toro frente a la manta #HayNivelesPareja"
    },
    { "type": "text", "id": "position_mobile", "label": "Encuadre en teléfono (x% y%)", "default": "44% 40%" },
    { "type": "text", "id": "position_desktop", "label": "Encuadre en escritorio (x% y%)", "default": "50% 35%" },
    { "type": "text", "id": "title_1", "label": "Frase · línea 1", "default": "¡¡Hay niveles" },
    { "type": "text", "id": "title_2", "label": "Frase · línea 2 (en rojo)", "default": "pareja!!" },
    { "type": "text", "id": "button_label", "label": "Botón", "default": "Ver las gorras" },
    {
      "type": "text",
      "id": "button_link",
      "label": "Enlace del botón",
      "info": "#gorras baja a la sección de gorras de esta página.",
      "default": "#gorras"
    },
    { "type": "text", "id": "credit", "label": "Crédito de la foto", "default": "Foto: Aferrados al Jaripeo" }
  ],
  "presets": [{ "name": "REP2 · Portada" }]
}
{% endschema %}
