{%- liquid
  assign s = section.settings
  assign shown = 0
-%}

{%- if s.collection != blank and s.collection.products_count > 1 -%}
  <section class="rep3 rep3-otras">
    <div class="rep3-wrap">
      <h2 class="rep3-h2">{{ s.heading | escape }}</h2>
      <div class="rep3-otras__grid">
        {%- for p in s.collection.products -%}
          {%- if p.id == product.id -%}
            {%- continue -%}
          {%- endif -%}
          {%- if shown >= 3 -%}
            {%- break -%}
          {%- endif -%}
          {%- assign shown = shown | plus: 1 -%}
          {% render 'rep3-card', product: p, prefix: s.name_prefix, sizes: '(min-width: 760px) 300px, 50vw', agregar: true, section_id: section.id %}
        {%- endfor -%}
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "REP3 · Las otras gorras",
  "tag": "div",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    { "type": "text", "id": "heading", "label": "Título", "default": "Las otras gorras" },
    { "type": "collection", "id": "collection", "label": "Colección" },
    { "type": "text", "id": "name_prefix", "label": "Quitar del nombre", "default": "Gorra El Principio" }
  ],
  "presets": [{ "name": "REP3 · Las otras gorras" }]
}
{% endschema %}
