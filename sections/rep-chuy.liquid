{%- liquid
  assign s = section.settings
  if s.image != blank
    assign chuy_src = s.image | image_url: width: 900
    assign chuy_alt = s.image.alt | default: s.image_alt
  else
    assign chuy_src = 'rep-chuy.jpg' | asset_url
    assign chuy_alt = s.image_alt
  endif
-%}

<section class="rep rep-chuy rep-camo" id="chuy">
  <div class="rep-chuy__veil">
    <div class="rep-wrap">
      <div class="rep-chuy__grid">
        <figure class="rep-chuy__fig">
          <img src="{{ chuy_src }}" alt="{{ chuy_alt | escape }}" width="384" height="426" loading="lazy">
          {%- if s.tag != blank -%}
            <figcaption class="rep-chuy__tag">{{ s.tag | escape }}</figcaption>
          {%- endif -%}
        </figure>

        <div class="rep-split__col">
          {%- if s.kicker != blank -%}
            <p class="rep-kicker">{{ s.kicker | escape }}</p>
          {%- endif -%}
          <h2 class="rep-h2">{{ s.heading_1 | escape }} <span class="rep-red">{{ s.heading_2 | escape }}</span></h2>
          {%- if s.body != blank -%}
            <div class="rep-body">{{ s.body }}</div>
          {%- endif -%}

          {%- if section.blocks.size > 0 -%}
            <ul class="rep-hitos">
              {%- for block in section.blocks -%}
                <li {{ block.shopify_attributes }}>
                  <span class="rep-hitos__t">{{ block.settings.title | escape }}</span>
                  <span class="rep-hitos__d{% if block.settings.slogan %} rep-hitos__d--slogan{% endif %}">
                    {{- block.settings.text | escape -}}
                  </span>
                </li>
              {%- endfor -%}
            </ul>
          {%- endif -%}

          <div class="rep-stack">
            {%- if s.instagram_url != blank -%}
              <a class="rep-btn rep-btn--white" href="{{ s.instagram_url }}" target="_blank" rel="noopener">Síguelo en Instagram</a>
            {%- endif -%}
            {%- if s.youtube_url != blank -%}
              <a class="rep-btn rep-btn--line" href="{{ s.youtube_url }}" target="_blank" rel="noopener">Sus jaripeos en YouTube</a>
            {%- endif -%}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "REP · Chuy Ordaz",
  "tag": "div",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Retrato" },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Descripción del retrato",
      "default": "Retrato de Chuy Ordaz con sombrero y camisa blancos"
    },
    { "type": "text", "id": "tag", "label": "Etiqueta sobre la foto", "default": "Chuy Ordaz" },
    { "type": "text", "id": "kicker", "label": "Antetítulo", "default": "Al frente de la ganadería" },
    { "type": "text", "id": "heading_1", "label": "Título", "default": "Chuy" },
    { "type": "text", "id": "heading_2", "label": "Título (en rojo)", "default": "Ordaz" },
    {
      "type": "richtext",
      "id": "body",
      "label": "Texto",
      "default": "<p>Dueño de Rancho El Principio, la ganadería de Tecomán, Colima, conocida en el jaripeo como la Selección Colimense. Con sus toros de reparo ha atendido jaripeos en todos los estados de la República y tiene presencia en la Unión Americana.</p>"
    },
    { "type": "text", "id": "instagram_url", "label": "Instagram", "default": "https://www.instagram.com/ranchoelprincipio_oficial/" },
    { "type": "text", "id": "youtube_url", "label": "YouTube", "default": "https://www.youtube.com/c/RanchoElPrincipioOficial" }
  ],
  "blocks": [
    {
      "type": "hito",
      "name": "Logro",
      "settings": [
        { "type": "text", "id": "title", "label": "Título", "default": "La Petatera 2024" },
        { "type": "textarea", "id": "text", "label": "Texto" },
        { "type": "checkbox", "id": "slogan", "label": "Mostrar como frase (rojo, mayúsculas)", "default": false }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "REP · Chuy Ordaz",
      "blocks": [
        {
          "type": "hito",
          "settings": {
            "title": "La Petatera 2024",
            "text": "Volvió después de cinco años a la plaza de Villa de Álvarez, con doce montas de compromiso en el Jaripeo Baile Nocturno de los Festejos Charrotaurinos."
          }
        },
        { "type": "hito", "settings": { "title": "Señor del Sombrero", "text": "El toro emblemático de la ganadería." } },
        {
          "type": "hito",
          "settings": {
            "title": "Toda la República",
            "text": "Hemos atendido jaripeos en todos los estados de la República y tenemos presencia en la Unión Americana."
          }
        },
        { "type": "hito", "settings": { "title": "Su frase", "text": "¡¡Hay niveles pareja!!", "slogan": true } }
      ]
    }
  ]
}
{% endschema %}
