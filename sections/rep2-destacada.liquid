{%- liquid
  assign s = section.settings
  assign p = s.product
-%}

{%- if p != blank -%}
  <section class="rep rep2-dest">
    <div class="rep2-dest__veil">
      <div class="rep2-dest__in">
        <a class="rep2-dest__media" href="{{ p.url }}" tabindex="-1" aria-hidden="true">
          {%- if p.featured_media != blank -%}
            {{
              p.featured_media
              | image_url: width: 1400
              | image_tag:
                loading: 'lazy',
                widths: '400, 700, 1000, 1400',
                sizes: '(min-width: 900px) 55vw, 90vw',
                alt: '',
                class: 'rep2-dest__img'
            }}
          {%- endif -%}
        </a>
        <div class="rep2-dest__txt">
          <h2 class="rep2-dest__h">
            <span>{{ s.title_1 | escape }}</span>
            <span>{{ s.title_2 | escape }}</span>
          </h2>
          {%- if s.text != blank -%}
            <p class="rep2-dest__d">{{ s.text | escape }}</p>
          {%- endif -%}
          <span class="rep2-dest__p">{{ p.price | money_without_trailing_zeros }}</span>
          {%- if s.button_label != blank -%}
            <a class="rep2-btn rep2-btn--crema" href="{{ p.url }}">{{ s.button_label | escape }}</a>
          {%- endif -%}
        </div>
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "REP2 · Gorra destacada",
  "tag": "div",
  "settings": [
    {
      "type": "paragraph",
      "content": "Una gorra sobre camuflaje. El camuflaje vive aquí y en la barra de aviso, no en toda la página."
    },
    { "type": "product", "id": "product", "label": "Gorra" },
    { "type": "text", "id": "title_1", "label": "Título · línea 1", "default": "Selección" },
    { "type": "text", "id": "title_2", "label": "Título · línea 2", "default": "Colimense" },
    { "type": "text", "id": "text", "label": "Texto", "default": "Color hueso, con visera de camuflaje." },
    { "type": "text", "id": "button_label", "label": "Botón", "default": "Ver la gorra" }
  ],
  "presets": [{ "name": "REP2 · Gorra destacada" }]
}
{% endschema %}
