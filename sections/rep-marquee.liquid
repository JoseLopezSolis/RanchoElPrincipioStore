{%- capture phrases -%}
  {%- for block in section.blocks -%}
    <span>{{ block.settings.text | escape }}</span><span class="rep-dia" aria-hidden="true"></span>
  {%- endfor -%}
{%- endcapture -%}

{%- if section.settings.show_piteado -%}
  <svg class="rep-piteado" aria-hidden="true" width="100%" height="14">
    <defs>
      <pattern id="pit-{{ section.id }}" width="22" height="14" patternUnits="userSpaceOnUse">
        <path d="M0 7 L11 2 L22 7 L11 12 Z" fill="none" stroke="#8C6A52" stroke-width="1.5"/>
        <circle cx="11" cy="7" r="1.5" fill="#8C6A52"/>
      </pattern>
    </defs>
    <rect width="100%" height="14" fill="url(#pit-{{ section.id }})"/>
  </svg>
{%- endif -%}

<div class="rep rep-marquee rep-camo">
  <div class="rep-marquee__track" style="animation-duration: {{ section.settings.speed }}s;">
    <div class="rep-marquee__group">{{ phrases }}</div>
    <div class="rep-marquee__group" aria-hidden="true">{{ phrases }}</div>
  </div>
</div>

{% schema %}
{
  "name": "REP · Cartel corrido",
  "tag": "div",
  "settings": [
    { "type": "checkbox", "id": "show_piteado", "label": "Mostrar cinta piteado arriba", "default": true },
    { "type": "range", "id": "speed", "label": "Duración de la vuelta", "min": 15, "max": 90, "step": 5, "unit": "s", "default": 40 }
  ],
  "blocks": [
    {
      "type": "phrase",
      "name": "Frase",
      "settings": [{ "type": "text", "id": "text", "label": "Texto", "default": "¡¡Hay niveles pareja!!" }]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "REP · Cartel corrido",
      "blocks": [
        { "type": "phrase", "settings": { "text": "¡¡Hay niveles pareja!!" } },
        { "type": "phrase", "settings": { "text": "Poquito pero fino" } },
        { "type": "phrase", "settings": { "text": "100% Colima" } },
        { "type": "phrase", "settings": { "text": "Selección Colimense" } },
        { "type": "phrase", "settings": { "text": "Chuy Ordaz" } },
        { "type": "phrase", "settings": { "text": "Toros de reparo" } }
      ]
    }
  ]
}
{% endschema %}
