{%- assign s = section.settings -%}

<section class="rep rep2-gorras" id="{{ s.anchor | default: 'gorras' | handleize }}">
  <div class="rep2-wrap rep2-sec">
    <div class="rep2-head">
      <h2 class="rep2-h2">{{ s.heading | escape }}</h2>
      {%- if s.subheading != blank -%}
        <p class="rep2-lead">{{ s.subheading | escape }}</p>
      {%- endif -%}
    </div>

    <div class="rep2-grid">
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.settings.product != blank -%}
            {% render 'rep2-card',
              product: block.settings.product,
              meta: block.settings.meta,
              prefix: s.name_prefix,
              attrs: block.shopify_attributes
            %}
          {%- endif -%}
        {%- endfor -%}
      {%- elsif s.collection != blank -%}
        {%- for p in s.collection.products limit: 8 -%}
          {% render 'rep2-card', product: p, prefix: s.name_prefix %}
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "REP2 · Gorras",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "heading", "label": "Título", "default": "Gorra El Principio" },
    { "type": "text", "id": "subheading", "label": "Subtítulo", "default": "Cuatro modelos, $1,200 cada una." },
    {
      "type": "text",
      "id": "name_prefix",
      "label": "Quitar del nombre",
      "info": "Las tarjetas muestran el nombre sin este texto inicial (\"Gorra El Principio Original\" → \"Original\").",
      "default": "Gorra El Principio"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Colección",
      "info": "Se usa si no agregas gorras una por una."
    },
    { "type": "text", "id": "anchor", "label": "Ancla", "info": "Para enlaces como #gorras.", "default": "gorras" }
  ],
  "blocks": [
    {
      "type": "producto",
      "name": "Gorra",
      "settings": [
        { "type": "product", "id": "product", "label": "Producto" },
        { "type": "text", "id": "meta", "label": "Nota corta", "info": "Ej. Negra, visera camuflaje" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [{ "name": "REP2 · Gorras" }]
}
{% endschema %}
