{%- assign s = section.settings -%}

<section class="rep3 rep3-redes" id="{{ s.anchor | default: 'redes' | handleize }}">
  <div class="rep3-wrap rep3-redes__head">
    <div class="rep3-redes__titulos">
      <h2 class="rep3-h2">{{ s.heading | escape }}</h2>
      {%- if s.handle != blank and s.instagram_url != blank -%}
        <a class="rep3-redes__handle" href="{{ s.instagram_url }}" target="_blank" rel="noopener">{{ s.handle | escape }}</a>
      {%- endif -%}
    </div>
    <div class="rep3-redes__botones">
      {%- if s.instagram_url != blank -%}
        <a class="rep3-btn rep3-btn--borde rep3-redes__btn" href="{{ s.instagram_url }}" target="_blank" rel="noopener">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor"/></svg>
          Instagram
        </a>
      {%- endif -%}
      {%- if s.facebook_url != blank -%}
        <a class="rep3-btn rep3-btn--borde rep3-redes__btn" href="{{ s.facebook_url }}" target="_blank" rel="noopener">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 3h-2.5A3.5 3.5 0 0 0 9 6.5V10H6v4h3v7h4v-7h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
          Facebook
        </a>
      {%- endif -%}
      {%- if s.youtube_url != blank -%}
        <a class="rep3-btn rep3-btn--borde rep3-redes__btn" href="{{ s.youtube_url }}" target="_blank" rel="noopener">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="5" width="20" height="14" rx="4"/><path d="M10 9l5 3-5 3z" fill="currentColor"/></svg>
          YouTube
        </a>
      {%- endif -%}
    </div>
  </div>

  {%- if section.blocks.size > 0 -%}
    <div class="rep3-redes__lista">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'instagram' -%}
            {%- liquid
              assign permalink = block.settings.url | split: '?' | first | strip
              assign ultimo = permalink | slice: -1
              if ultimo != '/'
                assign permalink = permalink | append: '/'
              endif
            -%}
            {%- if block.settings.url != blank -%}
              <div class="rep3-post rep3-post--ig" style="--rep3-ig-r: {{ block.settings.formato | default: '1' }};" {{ block.shopify_attributes }}>
                {%- comment -%} Barra propia en negro; la barra blanca de Instagram queda escondida arriba del marco. {%- endcomment -%}
                <a class="rep3-post__barra" href="{{ permalink }}" target="_blank" rel="noopener">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor"/></svg>
                  <span class="rep3-post__usuario">{{ s.handle | default: '@ranchoelprincipio_oficial' | escape }}</span>
                  <span class="rep3-post__ver">Ver</span>
                </a>
                <div class="rep3-post__marco">
                  {%- if block.settings.imagen != blank -%}
                    {%- comment -%} Foto fija de la publicación: sin flechas del carrusel ni marcos de Instagram. {%- endcomment -%}
                    <a class="rep3-post__foto" href="{{ permalink }}" target="_blank" rel="noopener" tabindex="-1">
                      {{ block.settings.imagen | image_url: width: 900 | image_tag: loading: 'lazy', widths: '400, 600, 900', sizes: '(min-width: 990px) 300px, (min-width: 760px) 33vw, 84vw', alt: 'Publicación de Instagram de Rancho El Principio' }}
                    </a>
                  {%- else -%}
                    <iframe
                      class="rep3-post__frame"
                      src="{{ permalink }}embed/"
                      title="Publicación de Instagram de Rancho El Principio"
                      loading="lazy"
                      scrolling="no"
                      allowtransparency="true"
                    ></iframe>
                  {%- endif -%}
                </div>
              </div>
            {%- endif -%}
          {%- when 'video' -%}
            {%- comment -%} Video propio: sin sonido, en bucle y sin la capa gris de Instagram. Sin archivo no se muestra. {%- endcomment -%}
            {%- if block.settings.video != blank -%}
              <div class="rep3-post rep3-post--video" {{ block.shopify_attributes }}>
                <a class="rep3-post__barra" href="{{ block.settings.link | default: s.instagram_url }}" target="_blank" rel="noopener">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor"/></svg>
                  <span class="rep3-post__usuario">{{ s.handle | default: '@ranchoelprincipio_oficial' | escape }}</span>
                  <span class="rep3-post__ver">Ver</span>
                </a>
                <div class="rep3-post__marco">
                  {{- block.settings.video | video_tag: autoplay: true, loop: true, muted: true, controls: false, playsinline: true, preload: 'none', image_size: '800x', class: 'rep3-post__video' -}}
                </div>
              </div>
            {%- endif -%}
          {%- when 'foto' -%}
            {%- assign b = block.settings -%}
            <a
              class="rep3-post rep3-post--foto"
              href="{{ b.link | default: s.instagram_url }}"
              target="_blank"
              rel="noopener"
              {{ block.shopify_attributes }}
            >
              {%- if b.image != blank -%}
                {{ b.image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '400, 600, 800', sizes: '(min-width: 760px) 340px, 84vw', alt: b.alt }}
              {%- else -%}
                <img src="{{ 'rep-monta-1.jpg' | asset_url }}" width="1600" height="1066" alt="{{ b.alt | escape }}" loading="lazy">
              {%- endif -%}
              {%- if b.caption != blank -%}
                <span class="rep3-post__pie">{{ b.caption | escape }}</span>
              {%- endif -%}
            </a>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "REP3 · Redes",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "heading", "label": "Título", "default": "Síguenos en nuestras redes" },
    { "type": "text", "id": "handle", "label": "Usuario", "default": "@ranchoelprincipio_oficial" },
    { "type": "text", "id": "instagram_url", "label": "Instagram", "default": "https://www.instagram.com/ranchoelprincipio_oficial/" },
    { "type": "text", "id": "facebook_url", "label": "Facebook", "default": "https://www.facebook.com/DeChuyOrdaz/" },
    { "type": "text", "id": "youtube_url", "label": "YouTube", "default": "https://www.youtube.com/c/RanchoElPrincipioOficial" },
    { "type": "text", "id": "anchor", "label": "Ancla", "info": "Para enlaces como #redes.", "default": "redes" }
  ],
  "blocks": [
    {
      "type": "instagram",
      "name": "Publicación de Instagram",
      "settings": [
        {
          "type": "text",
          "id": "url",
          "label": "Enlace de la publicación",
          "info": "Copia el enlace de la publicación o del reel. Ejemplo: https://www.instagram.com/p/XXXXXXXX/"
        },
        {
          "type": "image_picker",
          "id": "imagen",
          "label": "Foto de la publicación",
          "info": "Opcional. Con foto, la tarjeta muestra solo esa imagen (sin flechas ni marcos de Instagram) y «Ver» abre la publicación."
        },
        {
          "type": "select",
          "id": "formato",
          "label": "Formato de la foto en Instagram",
          "info": "Con el formato correcto la foto queda centrada y no se asoma la orilla blanca de Instagram.",
          "options": [
            { "value": "1", "label": "Cuadrada (1:1)" },
            { "value": "1.25", "label": "Vertical (4:5)" },
            { "value": "1.333", "label": "Vertical (3:4)" }
          ],
          "default": "1"
        }
      ]
    },
    {
      "type": "video",
      "name": "Video (sin sonido)",
      "settings": [
        {
          "type": "video",
          "id": "video",
          "label": "Video",
          "info": "Sube el video de la publicación. Se reproduce solo, sin sonido y en bucle. Si no subes nada, no se muestra."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Enlace a la publicación",
          "info": "El «Ver» de la barra lleva aquí."
        }
      ]
    },
    {
      "type": "foto",
      "name": "Foto con enlace",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Foto" },
        { "type": "text", "id": "alt", "label": "Descripción de la foto" },
        { "type": "text", "id": "caption", "label": "Texto sobre la foto" },
        { "type": "url", "id": "link", "label": "Enlace", "info": "Si lo dejas vacío, lleva al Instagram del rancho." }
      ]
    }
  ],
  "max_blocks": 20,
  "presets": [{ "name": "REP3 · Redes" }]
}
{% endschema %}
