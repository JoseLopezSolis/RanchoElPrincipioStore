{%- liquid
  assign s = section.settings
  if s.image != blank
    assign g_src = s.image | image_url: width: 1200
    assign g_alt = s.image.alt | default: s.image_alt
  else
    assign g_src = 'rep-monta-2.jpg' | asset_url
    assign g_alt = s.image_alt
  endif
-%}

<section class="rep rep-choc" id="ganaderia">
  <div class="rep-wrap">
    <div class="rep-split">
      <img
        class="rep-framed"
        src="{{ g_src }}"
        alt="{{ g_alt | escape }}"
        width="1600"
        height="1066"
        loading="lazy"
        style="object-position: {{ s.image_position | default: '50% 50%' }};"
      >
      <div class="rep-split__col">
        {%- if s.kicker != blank -%}
          <p class="rep-kicker">{{ s.kicker | escape }}</p>
        {%- endif -%}
        <h2 class="rep-h2">{{ s.heading_1 | escape }}<br>{{ s.heading_2 | escape }}</h2>
        {%- if s.body != blank -%}
          <div class="rep-body">{{ s.body }}</div>
        {%- endif -%}
        {%- if section.blocks.size > 0 -%}
          <ul class="rep-pillars">
            {%- for block in section.blocks -%}
              <li {{ block.shopify_attributes }}>
                <span class="rep-pillars__t">{{ block.settings.title | escape }}</span>
                <span class="rep-pillars__d">{{ block.settings.text | escape }}</span>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "REP · La ganadería",
  "tag": "div",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Foto" },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Descripción de la foto",
      "default": "Toro reparando frente a la manta Hay Niveles Pareja, 100% Colima"
    },
    { "type": "text", "id": "image_position", "label": "Encuadre de la foto (x% y%)", "default": "58% 50%" },
    { "type": "text", "id": "kicker", "label": "Antetítulo", "default": "La ganadería" },
    { "type": "text", "id": "heading_1", "label": "Título · línea 1", "default": "Selección" },
    { "type": "text", "id": "heading_2", "label": "Título · línea 2", "default": "Colimense" },
    {
      "type": "richtext",
      "id": "body",
      "label": "Texto",
      "default": "<p>Rancho El Principio cría toros de reparo en Colima para los jaripeos más bravos de México. Al frente, Chuy Ordaz.</p><p>En la plaza nos ubican por el camuflaje.</p>"
    }
  ],
  "blocks": [
    {
      "type": "pillar",
      "name": "Pilar",
      "settings": [
        { "type": "text", "id": "title", "label": "Título", "default": "Toros de reparo" },
        { "type": "text", "id": "text", "label": "Texto", "default": "Crianza propia" }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "name": "REP · La ganadería",
      "blocks": [
        { "type": "pillar", "settings": { "title": "Toros de reparo", "text": "Crianza propia" } },
        { "type": "pillar", "settings": { "title": "Jaripeo baile", "text": "Contrataciones" } },
        { "type": "pillar", "settings": { "title": "Raíz colimense", "text": "Colima, México" } }
      ]
    }
  ]
}
{% endschema %}
