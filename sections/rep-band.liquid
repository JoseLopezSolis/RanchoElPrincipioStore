{%- liquid
  assign s = section.settings
  if s.image != blank
    assign band_src = s.image | image_url: width: 2000
    assign band_alt = s.image.alt | default: s.image_alt
  else
    assign band_src = 'rep-monta-3.jpg' | asset_url
    assign band_alt = s.image_alt
  endif
-%}

<section class="rep rep-band">
  <img
    src="{{ band_src }}"
    alt="{{ band_alt | escape }}"
    width="1600"
    height="1066"
    loading="lazy"
    style="object-position: {{ s.image_position | default: '50% 50%' }};"
  >
  {%- if s.title != blank or s.caption != blank -%}
    <div class="rep-band__cap">
      {%- if s.title != blank -%}<span class="rep-band__t">{{ s.title | escape }}</span>{%- endif -%}
      {%- if s.caption != blank -%}<span class="rep-band__s">{{ s.caption | escape }}</span>{%- endif -%}
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "REP · Franja de foto",
  "tag": "div",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Foto" },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Descripción de la foto",
      "default": "El toro brinca sobre el jinete caído mientras el lazador y el payaso entran al ruedo"
    },
    { "type": "text", "id": "image_position", "label": "Encuadre de la foto (x% y%)", "default": "62% 50%" },
    { "type": "text", "id": "title", "label": "Título", "default": "Toros de reparo" },
    { "type": "text", "id": "caption", "label": "Pie de foto", "default": "Selección Colimense · Foto: Aferrados al Jaripeo" }
  ],
  "presets": [{ "name": "REP · Franja de foto" }]
}
{% endschema %}
