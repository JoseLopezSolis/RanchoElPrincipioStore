{%- assign s = section.settings -%}

<section class="rep rep2-frase{% if s.image != blank %} rep2-frase--foto{% endif %}">
  {%- if s.image != blank -%}
    <div class="rep2-frase__media">
      {{
        s.image
        | image_url: width: 1400
        | image_tag:
          loading: 'lazy',
          widths: '500, 800, 1100, 1400',
          sizes: '(min-width: 900px) 50vw, 100vw',
          class: 'rep2-frase__img'
      }}
    </div>
  {%- endif -%}
  <div class="rep2-frase__txt">
    <p class="rep2-frase__p">
      <span>{{ s.line_1 | escape }}</span>
      <span class="rep2-red-l">{{ s.line_2 | escape }}</span>
    </p>
  </div>
</section>

{% schema %}
{
  "name": "REP2 · Frase",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "line_1", "label": "Frase · línea 1", "default": "Poquito" },
    { "type": "text", "id": "line_2", "label": "Frase · línea 2 (en rojo)", "default": "pero fino" },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Foto junto a la frase",
      "info": "Ideal: una gorra puesta en la plaza o colgada en la puerta del toril. Sin foto, la frase queda sola."
    }
  ],
  "presets": [{ "name": "REP2 · Frase" }]
}
{% endschema %}
