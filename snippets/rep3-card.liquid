{% doc %}
  Tarjeta de gorra del diseño v3: foto sobre arena, nombre corto y precio en Inconsolata.

  @param {object} product - Producto a mostrar.
  @param {string} [prefix] - Texto que se quita del inicio del nombre (ej. "Gorra El Principio").
  @param {string} [sizes] - Atributo sizes de la foto.
  @param {string} [attrs] - Atributos del editor del tema (block.shopify_attributes).
  @param {boolean} [agregar] - Muestra el botón «Agregar» para comprarla sin abrir la ficha.
  @param {string} [section_id] - ID de la sección (requerido si agregar es verdadero).
{% enddoc %}

{%- liquid
  assign name = product.title
  if prefix != blank
    assign short = product.title | remove_first: prefix | strip
    if short != blank
      assign name = short
    endif
  endif
  assign img_sizes = sizes | default: '(min-width: 760px) 25vw, 156px'
-%}

<div class="rep3-card" {{ attrs }}>
<a class="rep3-card__link" href="{{ product.url }}">
  <span class="rep3-card__foto">
    {%- if product.featured_media != blank -%}
      {{
        product.featured_media
        | image_url: width: 800
        | image_tag:
          loading: 'lazy',
          widths: '300, 450, 600, 800',
          sizes: img_sizes,
          alt: product.title
      }}
    {%- else -%}
      {{ 'product-1' | placeholder_svg_tag }}
    {%- endif -%}
    {%- unless product.available -%}
      <span class="rep3-card__agotada">Sold out</span>
    {%- endunless -%}
  </span>
  <span class="rep3-card__nombre">{{ name | escape }}</span>
  <span class="rep3-card__precio">{{ product.price | money_without_trailing_zeros | remove: ' ' }}</span>
</a>
{%- if agregar -%}
  {% render 'rep3-agregar', product: product, section_id: section_id %}
{%- endif -%}
</div>
