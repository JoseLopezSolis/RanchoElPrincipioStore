{% doc %}
  Tarjeta de gorra del diseño v2: foto sobre arena, nombre corto, nota y precio.

  @param {object} product - Producto a mostrar.
  @param {string} [prefix] - Texto que se quita del inicio del nombre (ej. "Gorra El Principio").
  @param {string} [meta] - Nota corta debajo del nombre (ej. "Negra, visera camuflaje").
  @param {string} [sizes] - Atributo sizes de la foto.
  @param {string} [attrs] - Atributos del editor del tema (block.shopify_attributes).
{% enddoc %}

{%- liquid
  assign name = product.title
  if prefix != blank
    assign short = product.title | remove_first: prefix | strip
    if short != blank
      assign name = short
    endif
  endif
  assign img_sizes = sizes | default: '(min-width: 900px) 25vw, 50vw'
-%}

<a class="rep2-card" href="{{ product.url }}" {{ attrs }}>
  <span class="rep2-tile">
    {%- if product.featured_media != blank -%}
      {{
        product.featured_media
        | image_url: width: 800
        | image_tag:
          loading: 'lazy',
          widths: '300, 450, 600, 800',
          sizes: img_sizes,
          alt: product.title
      }}
    {%- else -%}
      {{ 'product-1' | placeholder_svg_tag }}
    {%- endif -%}
    {%- unless product.available -%}
      <span class="rep2-badge">Se fue al ruedo</span>
    {%- endunless -%}
  </span>
  <span class="rep2-card__name">{{ name | escape }}</span>
  {%- if meta != blank -%}
    <span class="rep2-card__meta">{{ meta | escape }}</span>
  {%- endif -%}
  <span class="rep2-card__price">{{ product.price | money_without_trailing_zeros }}</span>
</a>
