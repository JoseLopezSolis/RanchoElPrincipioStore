{%- assign s = block.settings -%}

<ul class="rep-envio" {{ block.shopify_attributes }}>
  {%- for i in (1..3) -%}
    {%- assign key = 'line_' | append: i -%}
    {%- if s[key] != blank -%}
      <li><span class="rep-dia" aria-hidden="true"></span><span>{{ s[key] }}</span></li>
    {%- endif -%}
  {%- endfor -%}
</ul>

{% schema %}
{
  "name": "REP · Envío y confianza",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "Actualiza estos textos si cambian las tarifas de envío en Configuración › Envío."
    },
    {
      "type": "inline_richtext",
      "id": "line_1",
      "label": "Línea 1",
      "default": "Envío a todo México: <strong>$170</strong>"
    },
    {
      "type": "inline_richtext",
      "id": "line_2",
      "label": "Línea 2",
      "default": "<strong>Envío gratis</strong> en 3 gorras o más"
    },
    {
      "type": "inline_richtext",
      "id": "line_3",
      "label": "Línea 3",
      "default": "Pago seguro · Producto oficial"
    }
  ],
  "presets": [{ "name": "REP · Envío y confianza" }]
}
{% endschema %}
